{
  "family": "fastapi-example-staging",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::526106069320:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "db",
      "image": "postgres:16-alpine",
      "essential": true,
      "secrets": [
        { "name": "POSTGRES_USER",     "valueFrom": "arn:aws:ssm:us-east-1:526106069320:parameter/fastapi/prod/POSTGRES_USER" },
        { "name": "POSTGRES_DB",       "valueFrom": "arn:aws:ssm:us-east-1:526106069320:parameter/fastapi/prod/POSTGRES_DB" },
        { "name": "POSTGRES_PASSWORD", "valueFrom": "arn:aws:ssm:us-east-1:526106069320:parameter/fastapi/prod/POSTGRES_PASSWORD" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "pg_isready -U $POSTGRES_USER -d $POSTGRES_DB"],
        "interval": 10,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fastapi-example",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "db"
        }
      }
    },
    {
      "name": "api",
      "image": "PLACEHOLDER",
      "essential": true,
      "dependsOn": [{ "containerName": "db", "condition": "HEALTHY" }],
      "portMappings": [{ "containerPort": 8000, "protocol": "tcp" }],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:ssm:us-east-1:526106069320:parameter/fastapi/prod/DATABASE_URL" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fastapi-example",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}