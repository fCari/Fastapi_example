{
  "family": "fastapi-example-staging",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["EC2"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::526106069320:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "db",
      "image": "postgres:17-alpine",
      "essential": true,
      "secrets": [
        { "name": "POSTGRES_USER",     "valueFrom": "arn:aws:ssm:us-east-1:526106069320:parameter/fastapi/prod/POSTGRES_USER" },
        { "name": "POSTGRES_DB",       "valueFrom": "arn:aws:ssm:us-east-1:526106069320:parameter/fastapi/prod/POSTGRES_DB" },
        { "name": "POSTGRES_PASSWORD", "valueFrom": "arn:aws:ssm:us-east-1:526106069320:parameter/fastapi/prod/POSTGRES_PASSWORD" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "pg_isready -U $POSTGRES_USER -d $POSTGRES_DB"],
        "interval": 10,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fastapi-example",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "db"
        }
      }
    },
    {
      "name": "redis",
      "image": "redis:7-alpine",
      "essential": true,
      "healthCheck": {
        "command": ["CMD-SHELL", "redis-cli ping | grep -q PONG"],
        "interval": 10,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 5
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fastapi-example",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "redis"
        }
      }
    },
    {
      "name": "api",
      "image": "PLACEHOLDER",
      "essential": true,
      "dependsOn": [
        { "containerName": "db",    "condition": "HEALTHY" },
        { "containerName": "redis", "condition": "HEALTHY" }
      ],
      "portMappings": [{ "containerPort": 8000, "protocol": "tcp" }],
      "environment": [
        { "name": "REDIS_URL", "value": "redis://localhost:6379/0" },
        { "name": "CACHE_KEY", "value": "users:all" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:ssm:us-east-1:526106069320:parameter/fastapi/prod/DATABASE_URL" }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)\" || exit 1"
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 40
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fastapi-example",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}